---
// Inline image that opens a larger copy in a lightbox <dialog>.
// Without JS it's a plain link to the large image.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  widths?: number[];
  sizes?: string;
}

const { src, alt, caption, width = 1216, widths, sizes } = Astro.props;
const large = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' });
---

<figure class="zoom">
  <a href={large.src} class="zoom-trigger" data-zoom-trigger aria-label={`View larger: ${alt}`}>
    <Image src={src} alt={alt} width={width} widths={widths} sizes={sizes} loading="lazy" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}

  <dialog class="zoom-dialog" data-zoom-dialog aria-label={alt}>
    <button type="button" class="zoom-close" data-zoom-close aria-label="Close">esc ✕</button>
    <img
      data-src={large.src}
      alt={alt}
      width={large.attributes.width}
      height={large.attributes.height}
      decoding="async"
    />
    {caption && <p class="zoom-caption">{caption}</p>}
  </dialog>
</figure>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLElement>('figure.zoom').forEach((fig) => {
      if (fig.dataset.zoomBound) return;
      fig.dataset.zoomBound = '1';
      const trigger = fig.querySelector<HTMLAnchorElement>('[data-zoom-trigger]');
      const dialog = fig.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
      const img = dialog?.querySelector<HTMLImageElement>('img');
      if (!trigger || !dialog || !img || typeof dialog.showModal !== 'function') return;

      trigger.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // allow open-in-new-tab
        e.preventDefault();
        if (!img.src && img.dataset.src) img.src = img.dataset.src;
        dialog.showModal();
      });
      // any click closes: backdrop, image, or the close button
      dialog.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => trigger.focus({ preventScroll: true }));
    });
  };
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .zoom { margin: 0; }
  .zoom-trigger {
    display: block;
    cursor: zoom-in;
    border-radius: var(--r-lg);
  }
  .zoom-trigger :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-md);
    background: var(--c-bg-sunken);
    transition: transform var(--dur-normal) var(--ease-out), box-shadow var(--dur-normal) var(--ease-out);
  }
  .zoom-trigger:hover :global(img) {
    transform: scale(1.01);
    box-shadow: var(--shadow-lg);
  }
  figcaption {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text-dim);
  }

  .zoom-dialog {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: var(--s-6) var(--s-4);
    border: 0;
    background: transparent;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    cursor: zoom-out;
  }
  .zoom-dialog[open] {
    display: flex;
    animation: zoom-in 260ms var(--ease-out);
  }
  .zoom-dialog::backdrop {
    background: rgb(10 10 12 / 0.88);
    backdrop-filter: blur(4px);
    animation: zoom-fade 260ms var(--ease-out);
  }
  .zoom-dialog img {
    max-width: min(100%, 1600px);
    max-height: calc(100dvh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-md);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.5);
  }
  .zoom-caption {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.75);
  }
  .zoom-close {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.8);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--r-sm);
    padding: 0.3em 0.7em;
  }
  .zoom-close:hover { color: #fff; border-color: rgb(255 255 255 / 0.6); }
  .zoom-close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  @keyframes zoom-in {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes zoom-fade { from { opacity: 0; } }

  :global(html:has(.zoom-dialog[open])) { overflow: hidden; }
</style>
