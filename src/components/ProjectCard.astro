---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'featured' | 'compact';
}

const { project, variant = 'compact' } = Astro.props;
const { data, id } = project;
const href = `/projects/${id}`;
---

<a href={href} class:list={['card', variant]} data-card>
  <div class="head">
    <h3 class="title" transition:name={`project-title-${id}`}>{data.title}</h3>
    <span class="year">{data.year}</span>
  </div>
  <p class="tagline">{data.tagline}</p>
  {data.stack.length > 0 && (
    <ul class="stack" aria-label="Stack">
      {data.stack.slice(0, 5).map((s) => <li>{s}</li>)}
    </ul>
  )}
  <span class="more" aria-hidden="true">read →</span>
</a>

<script>
  // Pointer-tracked spotlight + tilt. Delegated so it survives page swaps.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !document.documentElement.dataset.cardFx) {
    document.documentElement.dataset.cardFx = '1';
    document.addEventListener('pointermove', (e) => {
      const card = (e.target as Element | null)?.closest<HTMLElement>('[data-card]');
      if (!card) return;
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      card.style.setProperty('--mx', `${px * 100}%`);
      card.style.setProperty('--my', `${py * 100}%`);
      if (!still) {
        card.style.setProperty('--rx', `${(0.5 - py) * 5}deg`);
        card.style.setProperty('--ry', `${(px - 0.5) * 7}deg`);
      }
    }, { passive: true });
    document.addEventListener('pointerout', (e) => {
      const card = (e.target as Element | null)?.closest<HTMLElement>('[data-card]');
      if (!card || card.contains(e.relatedTarget as Node | null)) return;
      card.style.setProperty('--rx', '0deg');
      card.style.setProperty('--ry', '0deg');
    });
  }
</script>

<style>
  .card {
    --mx: 50%;
    --my: 0%;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    isolation: isolate;
    display: block;
    height: 100%;
    color: var(--c-text);
    text-decoration: none;
    background: var(--c-bg-raised);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: var(--s-5);
    box-shadow: var(--shadow-sm);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition:
      border-color var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out),
      transform 400ms var(--ease-out);
  }
  /* soft spotlight fill */
  .card::before,
  /* spotlight-lit border */
  .card::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-normal) var(--ease-out);
  }
  .card::before {
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--c-accent) 9%, transparent),
      transparent 60%
    );
  }
  .card::after {
    inset: -1px;
    padding: 1px;
    background: radial-gradient(
      260px circle at var(--mx) var(--my),
      var(--c-accent),
      transparent 70%
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-lg);
  }
  .card:hover::before,
  .card:hover::after { opacity: 1; }
  .card:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  .card.featured {
    padding: var(--s-6);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-2);
  }
  .title {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    color: var(--c-text);
  }
  .featured .title { font-size: var(--fs-xl); }
  .year {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text-dim);
  }
  .tagline {
    color: var(--c-text-muted);
    margin-bottom: var(--s-3);
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text-dim);
    border: 1px solid var(--c-border);
    padding: 0.15em 0.55em;
    border-radius: var(--r-sm);
  }
  .stack li { background: var(--c-bg); }
  .more {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-accent);
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .card:hover .more { transform: translateX(4px); }
</style>
