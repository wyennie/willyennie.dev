---
import Layout from '~/layouts/Layout.astro';
import ZoomImage from '~/components/ZoomImage.astro';
import photo from '~/assets/now-photo.jpg';

const updated = '2026-05-08';
---

<Layout
  title="now"
  description="What Will Yennie is working on, learning, and looking for right now."
>
  <div class="container page">
    <header class="head">
      <h1>now</h1>
      <p class="meta">Updated {updated}, from my Bushwick apartment ·
        <a href="https://nownownow.com/about" rel="noopener">/now page</a>
      </p>
    </header>

    <h2>Working on</h2>
    <ul>
      <li>This site. Publishing notes I should have written down the first time I figured them out, pulling things out of private docs and into posts.</li>
      <li>Workforce: budget limits for missions.</li>
      <li>Managing a websites for a few local businesses.</li>
    </ul>

    <h2>Other Things</h2>
    <ul>
      <li>Reading <em>Infinite Jest</em> by David Foster Wallace.</li>
      <li>Listening to <em>The Eye of the World (Wheel of Time 1)</em> by Robert Jordan.</li> 
      <li>Game Master Prep: Preparing for PC's fight against rival band of mercenaries.</li>
    </ul>

    <h2>From the camera roll</h2>
    <ZoomImage
      src={photo}
      alt="Sunset over the bay at Long Beach in Noyack, NY: blue clouds above a thin orange horizon, with shallow water washing over a rocky beach in the foreground"
      caption="Long Beach, Noyack, NY"
      width={1216}
      widths={[608, 912, 1216]}
      sizes="(max-width: 51rem) calc(100vw - 3rem), 48rem"
    />

    <h2>Looking for</h2>
    <p>A full-stack role with real product surface: debugging, observability, performance, the kinds of problems that reward going deep. Language-agnostic. Based in New York; onsite, hybrid, or remote.</p>

    <p class="footnote">
      This is a <a href="https://nownownow.com/about" rel="noopener">now page</a>,
      in the Sivers sense: what's actually true today, not a permanent bio.
    </p>
  </div>
</Layout>

<style>
  .page { padding-block: var(--s-7) var(--s-8); }
  .page > :global(:is(p, ul, ol, figure)) { max-width: var(--prose-max); }
  .head { margin-bottom: var(--s-6); }
  .head h1 { font-size: var(--fs-2xl); }
  .meta { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--c-text-muted); margin-top: var(--s-2); }
  h2 {
    font-size: var(--fs-md);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    margin-top: var(--s-6);
    margin-bottom: var(--s-3);
  }
  ul { padding-left: 1.25rem; }
  ul li { margin-bottom: var(--s-2); }
  .footnote {
    margin-top: var(--s-7);
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
    border-top: 1px solid var(--c-border);
    padding-top: var(--s-4);
  }
</style>
