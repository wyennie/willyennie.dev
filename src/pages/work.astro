---
import Layout from '~/layouts/Layout.astro';
import { SITE } from '~/lib/site';

/* TODO(Will): walk this list and prune anything you wouldn't want to be
   asked about in a technical interview. The current list is what shows up
   across willyennie.com + your projects + likely Insight Designs work; some
   of it (Sidekiq, Redis, GraphQL, Stimulus, Astro, Vite) is plausible but
   not directly evidenced in the public sources. Cut what isn't real. */
const skills = {
  Languages: ['JavaScript', 'TypeScript', 'Ruby', 'PHP', 'Python', 'Go', 'SQL', 'Bash'],
  'Backend & data': ['Node.js / Express', 'Rails', 'Sinatra', 'PostgreSQL', 'MongoDB', 'REST'],
  Frontend: ['React', 'Handlebars', 'ERB', 'CSS', 'Astro'],
  Infra: ['Docker', 'Terraform', 'AWS (Lambda, Kinesis Firehose, CloudWatch)', 'DigitalOcean', 'nginx'],
  Observability: ['OpenTelemetry', 'Grafana', 'Prometheus', 'Promscale / TimescaleDB'],
  'AI / agents': ['Anthropic Claude API', 'OpenAI API', 'claude-agent-sdk', 'prompt design', 'agent orchestration'],
  Practice: ['TDD', 'systems design', 'mastery-based learning'],
};

type Role = {
  company: string;
  title: string;
  location?: string;
  start: Date;
  end: Date | 'present';
  displayDate?: string;
  summary?: string;
  bullets?: string[];
  stack?: string[];
  anchor: string;
};

const fmtDate = (d: Date | 'present') =>
  d === 'present'
    ? 'present'
    : d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const fmtRange = (r: Role) =>
  r.displayDate ?? `${fmtDate(r.start)} – ${fmtDate(r.end)}`;

/* One chronological list. Roles and open-source / personal projects are
   intermixed, most-recent first, under a single Experience heading. */
const experience: Role[] = [
  {
    company: 'Insight Designs Web Solutions',
    title: 'Software Engineer',
    location: 'Boulder, CO (remote)',
    start: new Date(2025, 1),
    end: new Date(2026, 3),
    summary:
      'Full-stack and infrastructure work for a Boulder-based web design consultancy with 600+ clients across its portfolio.',
    bullets: [
      'Worked directly with clients to scope requirements and ship features and fixes across the agency\'s portfolio of sites.',
      'Built a Python tool to automate vulnerability monitoring across 100+ client sites, flagging outdated or compromised dependencies.',
      'Built a reusable Google Reviews component (Google Places API) that any client site could embed.',
      'Hardened DigitalOcean infrastructure for 40+ client websites: security updates (Apache, MySQL), SSL provisioning, and monitoring.',
    ],
    stack: ['Python', 'JavaScript', 'PHP', 'DigitalOcean', 'MySQL'],
    anchor: 'insight',
  },
  {
    company: 'open source',
    title: 'Workforce',
    start: new Date(2026, 0),
    end: new Date(2026, 0),
    displayDate: '2026',
    summary:
      'A CLI for dispatching multiple Claude coding agents in parallel, each isolated in its own git worktree with declared path-ownership lanes.',
    bullets: [
      'Designed a manager / specialist / reviewer pattern with runtime enforcement that prevents parallel agents from writing outside their declared file paths.',
      'Implemented persistent per-specialist memory with cross-project and per-project scopes, auto-captured after each mission via structured model output.',
      '600+ tests, published to PyPI, MCP server integration, and GitHub Actions support.',
    ],
    stack: ['Python', 'claude-agent-sdk', 'Typer', 'Pydantic', 'asyncio'],
    anchor: 'workforce',
  },
  {
    company: 'open source',
    title: 'Tabletop Ledger',
    start: new Date(2025, 0),
    end: new Date(2025, 0),
    displayDate: '2025',
    summary:
      'A campaign organizer for tabletop RPG game masters: a tree of pages with a WYSIWYG editor, plus an AI chat scoped to whichever page you are on.',
    bullets: [
      'Built a tree-structured page system with an inline WYSIWYG editor, so game masters nest factions, cities, NPCs, and session logs as one navigable hierarchy.',
      'Built a context-aware chat panel that scopes each answer to the current page, so a question about one NPC pulls from that page rather than the whole campaign.',
      'Streamed AI responses token-by-token over WebSockets, and ran a beta with real users that measured a 20% lift in satisfaction across the cycle.',
    ],
    stack: ['Rails', 'WebSockets', 'AI APIs', 'WYSIWYG editor'],
    anchor: 'ttledger',
  },
  {
    company: 'ZenML',
    title: 'Open-source contributor',
    location: 'Remote',
    start: new Date(2024, 5),
    end: new Date(2024, 9),
    displayDate: '2024',
    summary: 'Built a chatbot feature for the official ZenML VSCode extension.',
    bullets: [
      'Integrated OpenAI and Anthropic Claude APIs for context-aware chat scoped to the user\'s selected ML pipeline.',
      'Built the chat UI: dropdowns, interactive controls, per-conversation context selection, and state management.',
      'Implemented token-by-token message streaming so responses arrive live instead of as a single blocking call.',
    ],
    stack: ['TypeScript', 'VSCode Extension API', 'OpenAI API', 'Anthropic Claude API'],
    anchor: 'zenml',
  },
  {
    company: 'open source',
    title: 'Firefly',
    location: '4-person team',
    start: new Date(2022, 9),
    end: new Date(2023, 1),
    displayDate: '2022 – 2023',
    summary:
      'Open-source observability framework for AWS Lambda. Serverless function health via metrics and traces.',
    bullets: [
      'Implemented W3C TraceContext propagation across asynchronous Lambda invocations, fixing trace accuracy for cross-function event flows.',
      'Built a custom OpenTelemetry collector handling up to 500,000 metrics and trace data points per day.',
      'Built a CLI tool to automate Lambda instrumentation and AWS infrastructure setup, cutting setup time by up to 40 hours.',
    ],
    stack: ['Node.js', 'OpenTelemetry', 'AWS Lambda', 'Terraform', 'Docker', 'Promscale / TimescaleDB', 'Grafana'],
    anchor: 'firefly',
  },
];

const education = [
  {
    name: 'Launch School',
    detail: 'Multi-year mastery-based program in full-stack web development, with capstone in system design.',
    years: '2021 – 2023',
  },
];
---

<Layout title="work" description="Will Yennie résumé, roles, and stack." bodyClass="work-page">
  <article class="container resume">
    <header class="masthead">
      <div>
        <h1>Will Yennie</h1>
      </div>
      <ul class="contact">
        <li><a href={SITE.url}>{SITE.domain}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.location}</li>
        <li><a href={SITE.linkedin}>linkedin.com/in/will-yennie</a></li>
        <li><a href={SITE.github}>{SITE.github.replace('https://', '')}</a></li>
      </ul>
    </header>

    <div id="print" class="print-hint no-print">
      <p>
        <a href="/Will_Yennie_Resume.pdf" class="download-link" download>Download PDF</a>
        or press <kbd>⌘</kbd> / <kbd>Ctrl</kbd> + <kbd>P</kbd> to print this page.
      </p>
    </div>

    <section>
      <h2>Summary</h2>
      <p>
        Full-stack generalist who builds new things and fixes old things. I
        like puzzles, hard bugs, and going deep. Comfortable across
        JavaScript, TypeScript, Ruby, PHP, Python, Go, and SQL/NoSQL, with
        deep recent focus on agent/LLM tooling and infrastructure.
      </p>
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map((r) => (
        <article class="role" id={r.anchor}>
          <header class="role-head">
            <h3>{r.title} · <span class="company">{r.company}</span></h3>
            <span class="when">{fmtRange(r)}{r.location ? ` · ${r.location}` : ''}</span>
          </header>
          {r.summary && <p class="role-summary">{r.summary}</p>}
          {r.bullets && (
            <ul>
              {r.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {r.stack && (
            <p class="stack-line">
              <span class="lbl">stack:</span> {r.stack.join(' · ')}
            </p>
          )}
        </article>
      ))}
      <ul class="proj-line no-print">
        <li><strong>HookScope</strong>: webhook debugger; capture, inspect, and replay incoming webhooks against a local handler.</li>
        <li><strong>FlightWise / TaskVault / ShopSense</strong>: earlier full-stack work on flight visualization, task tracking, and e-commerce.</li>
        <li class="muted">Full case studies at <a href="/projects">willyennie.dev/projects</a>.</li>
      </ul>
    </section>

    <section class="cols">
      <div>
        <h2>Skills</h2>
        <dl class="skills">
          {Object.entries(skills).map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v.join(', ')}</dd>
            </>
          ))}
        </dl>
      </div>

      <div>
        <h2>Education</h2>
        {education.map((e) => (
          <article class="edu">
            <h3>{e.name}</h3>
            <p>{e.detail}</p>
            <p class="when">{e.years}</p>
          </article>
        ))}
      </div>
    </section>
  </article>
</Layout>

<script>
  // The downloadable PDF is generated by loading /work/?pdf and printing it
  // headlessly. The `pdf-build` class opens up the line-height/spacing so the
  // content fills the page; a normal Ctrl+P (no ?pdf) keeps the tighter
  // spacing the live print path needs to stay on one page.
  if (new URLSearchParams(window.location.search).has('pdf')) {
    document.documentElement.classList.add('pdf-build');
  }

  const triggerPrintFromHash = () => {
    if (window.location.hash === '#print') {
      history.replaceState(null, '', window.location.pathname);
      window.print();
    }
  };
  triggerPrintFromHash();
  document.addEventListener('astro:page-load', triggerPrintFromHash);
</script>

<style>
  .resume {
    padding-block: var(--s-7) var(--s-8);
  }
  /* Resume reads as a document, not a terminal: normal sans throughout,
     overriding the site-wide mono headers/labels for legibility. */
  .resume :is(h1, h2, h3),
  .resume .contact,
  .resume .when,
  .resume .stack-line,
  .resume .skills dt {
    font-family: var(--font-sans);
  }
  .masthead {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    align-items: flex-start;
    justify-content: space-between;
    border-bottom: 1px solid var(--c-border);
    padding-bottom: var(--s-5);
    margin-bottom: var(--s-6);
  }
  .masthead h1 { font-size: var(--fs-2xl); }
  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
    text-align: right;
    line-height: var(--lh-snug);
  }
  .print-hint {
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--r-md);
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-6);
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
  }
  .download-link {
    font-weight: 600;
    color: var(--c-accent);
  }

  section { margin-bottom: var(--s-7); }
  section h2 {
    font-size: var(--fs-md);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-accent);
    border-bottom: 1px solid var(--c-border);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .role { margin-bottom: var(--s-6); }
  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .role-head h3 { font-size: var(--fs-md); }
  .company { color: var(--c-text-muted); font-weight: 400; }
  .when {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }
  .role-summary {
    margin-top: var(--s-2);
    color: var(--c-text-muted);
  }
  .role ul {
    margin-top: var(--s-2);
  }
  .role ul li { margin-bottom: var(--s-1); }
  .stack-line {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-text-dim);
  }
  .stack-line .lbl { color: var(--c-text-muted); }

  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--s-6);
  }
  @media (max-width: 640px) {
    .cols { grid-template-columns: 1fr; }
    .masthead { flex-direction: column; }
    .contact { text-align: left; }
  }
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--s-4);
    row-gap: var(--s-2);
    align-items: baseline;
  }
  .skills dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-text-muted);
  }
  .skills dd { margin-left: 0; }

  .edu h3 { font-size: var(--fs-md); }
  .edu p { color: var(--c-text-muted); }

  .proj-line { padding-left: 1.25rem; }
  .proj-line li { margin-bottom: var(--s-2); }
  .muted { color: var(--c-text-muted); margin-bottom: var(--s-3); }

  /* Print refinements specific to this page.

     Standard 0.5in margins on one page. The margin is supplied as document
     padding rather than via @page, because the two print paths treat @page
     differently: headless Chromium (the generated download) ignores @page
     margins and prints edge-to-edge, and a browser Ctrl+P adds its own margins
     on top of @page. Padding is honored identically by both, so it gives a
     consistent 0.5in frame either way. @page margin stays 0 so that padding
     isn't stacked on top of a page margin (which would push content onto a
     second page). Type/spacing fit all content on one page within those
     margins.

     The generated download (.pdf-build, loaded via /work/?pdf) opens the
     line-height and section/role spacing so the same content fills the page
     instead of leaving a tall bottom margin. Ctrl+P keeps the tighter base
     spacing. */
  @page { size: letter; margin: 0; }
  @media print {
    .resume { padding: 0.5in; max-width: none; font-size: 7.5pt; line-height: 1.05; }
    section { margin-bottom: 0.06rem; }
    section h2 {
      font-size: 9pt;
      margin-bottom: 0.12rem;
      padding-bottom: 0.06rem;
      border-bottom: 1px solid #999;
      color: #000;
    }
    .masthead { padding-bottom: 0.16rem; margin-bottom: 0.16rem; }
    .masthead h1 { font-size: 15pt; }
    .contact { font-size: 7pt; line-height: 1.2; }
    .role { page-break-inside: avoid; break-inside: avoid; margin-bottom: 0.14rem; }
    .role-head h3 { font-size: 9pt; }
    .role-summary { margin-top: 0.05rem; }
    .role ul { margin-top: 0.05rem; padding-left: 1rem; }
    .role ul li { margin-bottom: 0.01rem; }
    .stack-line { margin-top: 0.07rem; font-size: 7pt; }
    .cols { gap: 1rem; }
    .cols > div { page-break-inside: avoid; break-inside: avoid; }
    .skills { row-gap: 0.06rem; column-gap: 0.5rem; }
    .skills dd { font-size: 7.5pt; }
    .edu h3 { font-size: 9.5pt; }
    .edu p { font-size: 8pt; margin-top: 0.06rem; }
    .proj-line li { orphans: 1; widows: 1; }

    /* Download-only: open up spacing so the page fills out. :global because
       .pdf-build sits on <html>, outside this component's scope. */
    :global(.pdf-build) .resume { line-height: 1.34; }
    :global(.pdf-build) section { margin-bottom: 0.45rem; }
    :global(.pdf-build) section h2 { margin-bottom: 0.15rem; }
    :global(.pdf-build) .role { margin-bottom: 0.22rem; }
    :global(.pdf-build) .role-summary { margin-top: 0.07rem; }
    :global(.pdf-build) .role ul { margin-top: 0.07rem; }
    :global(.pdf-build) .role ul li { margin-bottom: 0.03rem; }
    :global(.pdf-build) .stack-line { margin-top: 0.09rem; }
  }
</style>
